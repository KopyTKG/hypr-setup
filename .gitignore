# Backups (e.g. created by install.sh)
*.bak
*.bak.*

# Caches / logs that may slip in
**/cache/
**/Cache/
**/Caches/
**/logs/
**/*.log
# Scratch journalctl/dmesg dumps pasted at the repo root while debugging
/log.txt

# Editor scratch
.DS_Store
*.swp
*~

# Nested side-repos (own .git, tracked elsewhere)
/work-scripts/

# Old monolithic .bashrc location — replaced by bash/.bashrc.
# Apps occasionally touch ~/.bashrc which resolves here via symlink.
/.bashrc
