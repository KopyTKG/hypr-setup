# Theme: arch-stone (Tailwind stone palette — monochrome UI, colored gradients)

# UI chrome — stone monochrome
theme[main_bg]="#0c0a09"
theme[main_fg]="#fafaf9"
theme[title]="#fafaf9"
theme[hi_fg]="#d6d3d1"
theme[selected_bg]="#44403c"
theme[selected_fg]="#fafaf9"
theme[inactive_fg]="#78716c"
theme[graph_text]="#d6d3d1"
theme[meter_bg]="#292524"
theme[proc_misc]="#d6d3d1"
theme[cpu_box]="#44403c"
theme[mem_box]="#44403c"
theme[net_box]="#44403c"
theme[proc_box]="#44403c"
theme[div_line]="#44403c"

# Gradients — keep functional colors so high cpu/temp/memory still reads as warning
theme[temp_start]="#9ece6a"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

theme[cpu_start]="#9ece6a"
theme[cpu_mid]="#e0af68"
theme[cpu_end]="#f7768e"

theme[free_start]="#9ece6a"
theme[free_mid]="#e0af68"
theme[free_end]="#f7768e"

theme[cached_start]="#9ece6a"
theme[cached_mid]="#e0af68"
theme[cached_end]="#f7768e"

theme[available_start]="#9ece6a"
theme[available_mid]="#e0af68"
theme[available_end]="#f7768e"

theme[used_start]="#9ece6a"
theme[used_mid]="#e0af68"
theme[used_end]="#f7768e"

theme[download_start]="#9ece6a"
