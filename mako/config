# Layout / behavior (inlined from omarchy default)
anchor=top-right
group-by=app-name,summary,body
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=1
border-radius=12
max-icon-size=32
font=sans-serif 14px

# Stone monochrome palette (matches waybar pills + walker)
text-color=#fafaf9
border-color=#f5f5f4
background-color=#1c1917

[app-name=Spotify]
invisible=1

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0
layer=overlay

[summary~="Screenshot copied & saved"]
max-icon-size=80
format=<b>%s</b>\n%b
