#!/usr/bin/env bash
# launch-or-focus CLASS COMMAND [ARGS...]
# Focus the first Hyprland window whose class contains CLASS (regex). If no
# window matches, exec COMMAND.

set -eu

CLASS="${1:?missing window class}"
shift

if command -v hyprctl >/dev/null 2>&1; then
  if hyprctl clients -j 2>/dev/null | grep -qiE "\"class\":[[:space:]]*\"[^\"]*${CLASS}[^\"]*\""; then
    hyprctl dispatch focuswindow "class:$CLASS" >/dev/null
    exit 0
  fi
fi

exec "$@"
