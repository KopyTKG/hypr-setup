#!/bin/bash
# arch-launch-apps — the app launcher (SUPER+SPACE, Menu → Apps).
#
# Uses spot's own launcher (spot-config/launcher.toml, `type = "apps"`) when the
# installed spot is 0.5.0 or newer; on an older spot it falls back to walker so
# the key never goes dead. Emoji and clipboard (SUPER+CTRL+E / V) still use
# walker until spot has those sources.

ver=$(spot --version 2>/dev/null | awk '{print $2}')
ver=${ver%%-*}                                   # 0.5.0-3-gabc123 -> 0.5.0

if [[ $ver == dev || ( -n $ver && $(printf '%s\n0.5.0\n' "$ver" | sort -V | head -n1) == 0.5.0 ) ]]; then
  exec spot launcher
fi
exec walker
