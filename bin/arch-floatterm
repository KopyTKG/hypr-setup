#!/bin/bash
# arch-floatterm — spawn a floating kitty window with the given window class.
# The class is what Hyprland windowrules match on to float/style the spawn.
#
# Usage:
#   arch-floatterm <class> <command...>
#
# Examples:
#   arch-floatterm arch-btop btop
#   arch-floatterm arch-impala sh -c 'rfkill unblock wifi; exec impala'
#   setsid -f arch-floatterm ssh-session ssh user@host & disown
#
# Replaces the verbose `uwsm-app -- kitty --class X Y` pattern.

if [[ $# -lt 2 ]]; then
  echo "usage: arch-floatterm <class> <command...>" >&2
  exit 2
fi

class=$1
shift

# kitty takes the program after its options (no -e)
if ! command -v kitty >/dev/null 2>&1; then
  echo "arch-floatterm: kitty is not installed (sudo pacman -S kitty)" >&2
  exit 127
fi
TERM_CMD=(kitty --class "$class")

# A helper that is not on PATH (a new bin/arch-* script before install.sh has
# linked it) would make the window flash and close. Say what is wrong instead.
if ! command -v "$1" >/dev/null 2>&1; then
  exec uwsm-app -- "${TERM_CMD[@]}" bash -c '
    printf "\033[31m%s: command not found\033[0m\n\n" "$1"
    echo "It is probably a new script in the repo that is not linked yet. Run:"
    echo "  ~/Projects/hypr-setup/install.sh"
    echo; read -r -p "[Enter to close]"' _ "$1"
fi

exec uwsm-app -- "${TERM_CMD[@]}" "$@"
