#!/bin/bash
# Focus an existing chromium --app window by class, else launch one.
# Usage: webapp.sh <class> <url>
CLASS="$1"
URL="$2"
if [[ -z $CLASS || -z $URL ]]; then
  echo "Usage: $0 <class> <url>" >&2
  exit 1
fi
if hyprctl clients -j | grep -q "\"class\": \"$CLASS\""; then
  hyprctl dispatch focuswindow "class:$CLASS"
else
  exec uwsm-app -- chromium --app="$URL" --class="$CLASS"
fi
