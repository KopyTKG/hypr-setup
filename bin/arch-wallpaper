#!/bin/bash
# arch-wallpaper — animated wallpaper with mpvpaper, laptop-friendly.
#
#   arch-wallpaper pick          choose a video (spot list) or go back to the static image
#   arch-wallpaper set <file>    use this video (and turn animation on)
#   arch-wallpaper on | off      animation on / off (off = static image only)
#   arch-wallpaper battery [on|off|toggle]   also animate on battery (default off)
#   arch-wallpaper status        what is configured and what is running
#   arch-wallpaper watch         the daemon hypr autostart runs (see below)
#   arch-wallpaper refresh       re-draw now (after swaybg was restarted)
#   arch-wallpaper lock-sync     refresh the lock-screen picture (see below)
#
# swaybg (the static image) always stays running underneath; the video is drawn on
# top by mpvpaper. Animation is only active while ALL of these hold:
#   a video is set  ·  animation is on  ·  on AC power, or `battery on`
# so by default unplugging drops back to the static image (no GPU/battery cost) and
# plugging in brings the video back. `watch` polls the power state every 30 s.
# Menu → Toggle → Wallpaper on battery flips the `battery` setting.
# While the video runs, swaybg shows its FIRST FRAME (base.jpg) instead of the static
# image, so whatever shows through at the loop point is nearly identical to the video
# (a gap there used to flash the static image). On battery / animation off, swaybg
# goes back to the static image. The video loops as a one-item playlist with the next
# round prefetched (no reload gap).
# mpvpaper -p also pauses the video while the wallpaper is fully covered
# (fullscreen / maximised windows hide it, so nothing is decoded).
#
# Lock screen: hyprlock cannot play video, so it shows a still frame of the video
# (blurred by hyprlock.conf), kept at ~/.cache/arch-wallpaper/lock.jpg. It is rebuilt
# whenever the choice changes (needs ffmpeg); with animation off / no video it is the
# static background.jpg.
#
# Videos are looked for in ~/Videos/Wallpapers (WALLPAPER_DIR overrides). State:
# ~/.local/state/arch-wallpaper/{video,enabled,battery}. Tuning: MPV_OPTS (default below).
# Test hooks: WALLPAPER_DIR, XDG_STATE_HOME, XDG_RUNTIME_DIR, POWER_SUPPLY_DIR.

set -u
DIR=${WALLPAPER_DIR:-$HOME/Videos/Wallpapers}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/arch-wallpaper
PIDFILE=${XDG_RUNTIME_DIR:-/tmp}/arch-wallpaper.pid
MPV_OPTS=${MPV_OPTS:-"no-audio loop-playlist=inf prefetch-playlist=yes hwdec=auto-safe panscan=1.0 framedrop=vo"}
LOCK=${XDG_CACHE_HOME:-$HOME/.cache}/arch-wallpaper/lock.jpg
BASE=${XDG_CACHE_HOME:-$HOME/.cache}/arch-wallpaper/base.jpg
STATIC=${WALLPAPER_STATIC:-$HOME/.config/hypr/theme/background.jpg}
mkdir -p "$STATE" "$(dirname "$LOCK")"

notify() { notify-send -u low -a arch-wallpaper "Wallpaper" "$1" 2>/dev/null; }
get()    { cat "$STATE/$1" 2>/dev/null; }
on_ac()  {  # true when no battery is discharging (desktops have none: always AC)
  local f any=0
  for f in "${POWER_SUPPLY_DIR:-/sys/class/power_supply}"/*/online; do [[ -r $f ]] || continue; any=1; [[ $(<"$f") == 1 ]] && return 0; done
  (( any )) && return 1 || return 0
}

power_ok() { [[ $(get battery) == on ]] || on_ac; }

want() {  # prints the video path when animation should be running now, else nothing
  local v; v=$(get video)
  [[ -n $v && -f $v && $(get enabled) != off ]] && power_ok && command -v mpvpaper >/dev/null 2>&1 && printf '%s' "$v"
}

# running <program> <rest of its command line> — the process may show as a full path
running() { pgrep -xf "([^ ]*/)?$1 $(printf '%s' "$2" | sed 's/[][\\.*^$+?(){}|]/\\&/g')" >/dev/null; }
playing() { pgrep -xf "([^ ]*/)?mpvpaper .* $(printf '%s' "$1" | sed 's/[][\\.*^$+?(){}|]/\\&/g')" >/dev/null; }

# SIGKILL: on SIGTERM mpvpaper tends to abort and dump core while tearing down.
stop_video() { pkill -KILL -x mpvpaper 2>/dev/null; while pgrep -x mpvpaper >/dev/null; do sleep 0.1; done; }

set_base() {  # set_base <image> — make swaybg show it; new one first, then retire the old (no bare moment)
  local img=$1 old
  running swaybg "-i $img -m fill" && return 0
  old=$(pgrep -x swaybg)
  setsid -f uwsm-app -- swaybg -i "$img" -m fill >/dev/null 2>&1
  sleep 0.4
  [[ -n $old ]] && kill $old 2>/dev/null
  return 0
}

apply() {  # apply [force]
  local v; v=$(want)
  if [[ -z $v ]]; then
    pgrep -x mpvpaper >/dev/null && stop_video
    set_base "$STATIC"
    return 0
  fi
  if [[ ${1:-} != force ]] && playing "$v" && running swaybg "-i $BASE -m fill"; then return 0; fi
  [[ -s $BASE ]] || cmd_lock_sync
  stop_video
  [[ -s $BASE ]] && set_base "$BASE"      # underlay first: mpvpaper must be started after swaybg to sit above it
  setsid -f uwsm-app -- mpvpaper -p -o "$MPV_OPTS" '*' "$v" >/dev/null 2>&1
}

poke() {  # wake the watcher so a change applies at once (else apply directly)
  local pid; pid=$(cat "$PIDFILE" 2>/dev/null)
  if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then kill -USR1 "$pid"; else apply "${1:-}"; fi
}

cmd_watch() {
  if [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi   # already running
  echo $$ > "$PIDFILE"
  trap 'rm -f "$PIDFILE"' EXIT
  trap 'FORCE=force' USR1
  FORCE=
  while :; do
    apply "$FORCE"; FORCE=
    sleep 30 & wait $!
    kill $! 2>/dev/null
  done
}

frame() {  # frame <seconds> <out.jpg> — one still from the current video
  ffmpeg -y -loglevel error -ss "$1" -i "$(get video)" -frames:v 1 -q:v 2 "$2.tmp.jpg" 2>/dev/null && [[ -s $2.tmp.jpg ]] \
    && mv -f "$2.tmp.jpg" "$2" || { rm -f "$2.tmp.jpg"; return 1; }
}

cmd_lock_sync() {  # lock-screen picture + the swaybg underlay frame
  local v; v=$(get video)
  if [[ -n $v && -f $v && $(get enabled) != off ]] && command -v ffmpeg >/dev/null 2>&1; then
    frame 1 "$LOCK" || cp -f "$STATIC" "$LOCK" 2>/dev/null
    frame 0 "$BASE" || rm -f "$BASE"
  else
    cp -f "$STATIC" "$LOCK" 2>/dev/null; rm -f "$BASE"
  fi
}

cmd_set() {
  local f; f=$(readlink -f -- "$1" 2>/dev/null)
  [[ -f $f ]] || { echo "arch-wallpaper: no such file: $1" >&2; exit 1; }
  printf '%s' "$f" > "$STATE/video"; echo on > "$STATE/enabled"
  command -v mpvpaper >/dev/null 2>&1 || { notify "mpvpaper is not installed (run bootstrap.sh)"; exit 1; }
  power_ok && notify "Animated: $(basename "$f")" || notify "Saved: $(basename "$f") — plays when plugged in (Toggle → Wallpaper on battery)"
  cmd_lock_sync
  poke force
}

cmd_pick() {
  local rows choice
  mkdir -p "$DIR"
  rows=$( { printf '%s\n' '  Static image (animation off)'; find -L "$DIR" -maxdepth 2 -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.gif' -o -iname '*.mov' \) -printf '%P\n' 2>/dev/null | sort; } )
  if [[ $(wc -l <<<"$rows") -le 1 ]]; then notify "No videos in $DIR — drop .mp4 / .webm / .gif files there"; fi
  choice=$(printf '%s\n' "$rows" | SPOT_TITLE="Wallpaper · $(get enabled | grep -q off && echo static || echo animated)" spot ${SPOT_BACK:+--back} ~/.config/spot/menu.toml) || exit 0
  [[ -n $choice ]] || exit 0
  case $choice in
    *Static*) cmd_off ;;
    *)        cmd_set "$DIR/$choice" ;;
  esac
}

cmd_off() { echo off > "$STATE/enabled"; cmd_lock_sync; poke; notify "Static wallpaper"; }
cmd_on()  { echo on  > "$STATE/enabled"; cmd_lock_sync; poke force; notify "Animation on"; }

cmd_battery() {
  local to=${1:-toggle}
  [[ $to == toggle ]] && { [[ $(get battery) == on ]] && to=off || to=on; }
  case $to in
    on)  echo on > "$STATE/battery"; echo on > "$STATE/enabled"   # asking for it also undoes `off`
         cmd_lock_sync; poke force
         [[ -f $(get video) ]] && notify "Animation on battery: on" || notify "Animation on battery: on — pick a video in Setup → Wallpaper" ;;
    off) echo off > "$STATE/battery"; poke; notify "Animation on battery: off" ;;
    *)   echo "arch-wallpaper: battery takes on, off or toggle" >&2; exit 2 ;;
  esac
}

cmd_status() {
  printf 'video:    %s\nanimate:  %s\non batt:  %s\npower:    %s\nrunning:  %s\n' \
    "$(get video || true)" "$(get enabled || echo on)" "$(get battery || echo off)" "$(on_ac && echo AC || echo battery)" \
    "$(pgrep -x mpvpaper >/dev/null && echo yes || echo no)"
}

case ${1:-pick} in
  pick)    cmd_pick ;;
  set)     cmd_set "${2:?usage: arch-wallpaper set <file>}" ;;
  on)      cmd_on ;;
  off)     cmd_off ;;
  battery) cmd_battery "${2:-}" ;;
  status)  cmd_status ;;
  watch)   cmd_watch ;;
  refresh) poke force ;;
  lock-sync) cmd_lock_sync ;;
  -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "arch-wallpaper: unknown command '$1' (see --help)" >&2; exit 2 ;;
esac
