#!/bin/bash
# arch-webapp-remove — remove web app launchers created by arch-webapp-install.
# No args → gum picker, args → remove by name.

set -e

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

if (( $# == 0 )); then
  WEB_APPS=()
  while IFS= read -r -d '' file; do
    if grep -qE '^Exec=.*(arch-launch-webapp|omarchy-launch-webapp|omarchy-webapp-handler)' "$file"; then
      WEB_APPS+=("$(basename "${file%.desktop}")")
    fi
  done < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0)

  if (( ${#WEB_APPS[@]} == 0 )); then
    echo "No web apps to remove."
    sleep 1
    exit 0
  fi

  IFS=$'\n' SORTED=($(sort <<<"${WEB_APPS[*]}"))
  unset IFS
  SELECTION=$(gum choose --no-limit --header "Select web apps to remove (space to mark, enter to confirm)" --selected-prefix="✗ " "${SORTED[@]}")
  APP_NAMES=()
  while IFS= read -r line; do
    [[ -n $line ]] && APP_NAMES+=("$line")
  done <<< "$SELECTION"
else
  APP_NAMES=("$@")
fi

(( ${#APP_NAMES[@]} > 0 )) || { echo "Nothing selected."; sleep 1; exit 0; }

for APP_NAME in "${APP_NAMES[@]}"; do
  rm -f "$DESKTOP_DIR/$APP_NAME.desktop"
  rm -f "$ICON_DIR/$APP_NAME.png"
  printf '\033[32m✓ Removed:\033[0m %s\n' "$APP_NAME"
done

# refresh walker index if it's running
pkill -SIGUSR1 walker 2>/dev/null || true
sleep 1
