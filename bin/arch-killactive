#!/bin/bash
# SUPER+W: dismiss the topmost layer surface we own (spot or walker),
# otherwise close the active toplevel window.
layers=$(hyprctl layers 2>/dev/null)
if grep -q 'namespace: spot' <<<"$layers"; then
  pkill -TERM -x spot
elif grep -q 'namespace: walker' <<<"$layers"; then
  walker --close
else
  hyprctl dispatch 'hl.dsp.window.close()'
fi
