#!/bin/bash
# SUPER+W: dismiss the spot dialog if one is showing, otherwise close the active
# toplevel window.
layers=$(hyprctl layers 2>/dev/null)
if grep -q 'namespace: spot' <<<"$layers"; then
  # Ask the daemon (pkill would kill the daemon too); an older spot without
  # --dismiss runs every dialog as its own process: kill those.
  spot --dismiss 2>/dev/null || pkill -TERM -x spot
else
  hyprctl dispatch 'hl.dsp.window.close()'
fi
