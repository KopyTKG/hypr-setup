#!/bin/bash
# arch-launcher-files <name> — the launcher's "." source: files and folders under
# $HOME whose name matches (fd), label = the name, comment = where it is.
# Enter opens it (xdg-open: yazi for folders). Needs fd.
q=$*
[[ -n $q ]] || exit 0
command -v fd >/dev/null 2>&1 || { printf 'fd is not installed\n'; exit 0; }
fd --ignore-case --max-results 40 --exclude .git --exclude node_modules --exclude .cache -- "$q" "$HOME" 2>/dev/null |
  awk -v home="$HOME" '{
    path = $0; sub(/\/$/, "", path)
    n = split(path, parts, "/"); name = parts[n]
    dir = path; sub(/\/[^\/]*$/, "", dir)
    if (index(dir, home) == 1) dir = "~" substr(dir, length(home) + 1)
    printf "%s\t%s\t%s\n", name, path, dir
  }'
