#!/bin/bash
# Toggle touchpad enabled/disabled via hyprctl.
device=$(hyprctl devices -j | jq -r '.mice[] | select(.name | test("touchpad"; "i")).name' | head -n1)
[[ -z $device ]] && { notify-send -u low "No touchpad detected"; exit 1; }
state=$(hyprctl getoption "device[$device]:enabled" -j 2>/dev/null | jq -r '.int')
if [[ $state == "1" ]]; then
  hyprctl keyword "device[$device]:enabled" false
  notify-send -u low "Touchpad: disabled"
else
  hyprctl keyword "device[$device]:enabled" true
  notify-send -u low "Touchpad: enabled"
fi
