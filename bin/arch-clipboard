#!/bin/bash
# arch-clipboard — clipboard history (SUPER+CTRL+V), replacing walker's clipboard
# provider. History is kept by cliphist, fed by `wl-paste --watch` (started from
# hypr/defaults/autostart.lua); this is the picker: a spot list, newest first.
# Enter copies the entry back and pastes it into the focused window (Shift+Insert).
#
#   arch-clipboard           the picker
#   arch-clipboard clear     forget the whole history
#
# Needs: cliphist (sudo pacman -S cliphist).

CFG=${ARCH_SPOT_DIR:-$HOME/.config/spot}

if ! command -v cliphist >/dev/null 2>&1; then
  notify-send -u critical -a arch-clipboard "Clipboard history" "cliphist is not installed:  sudo pacman -S cliphist" 2>/dev/null
  exit 1
fi

case ${1:-} in
  clear) cliphist wipe; notify-send -u low -a arch-clipboard "Clipboard history" "Cleared" 2>/dev/null; exit 0 ;;
  "") ;;
  *) echo "usage: arch-clipboard [clear]" >&2; exit 2 ;;
esac

history=$(cliphist list)                        # ID<TAB>preview, newest first
if [[ -z $history ]]; then
  notify-send -u low -a arch-clipboard "Clipboard history" "Nothing copied yet" 2>/dev/null
  exit 0
fi

# Show only the preview; find the entry again by it (cliphist keeps each content once).
choice=$(printf '%s\n' "$history" | cut -f2- | spot "$CFG/clipboard.toml") || exit 0
[[ -n $choice ]] || exit 0
entry=$(printf '%s\n' "$history" | PICK=$choice awk -F'\t' '{ p = $0; sub(/^[^\t]*\t/, "", p); if (p == ENVIRON["PICK"]) { print; exit } }')
[[ -n $entry ]] || exit 0

printf '%s' "$entry" | cliphist decode | wl-copy
sleep 0.15
hyprctl dispatch 'hl.dsp.send_shortcut({ mods = "SHIFT", key = "Insert" })' >/dev/null 2>&1
