#!/bin/bash
# arch-indicator-firewall — JSON status for waybar's custom/firewall module.
#
# UFW's systemd unit is Type=oneshot + RemainAfterExit=yes, so `systemctl
# is-active ufw` stays "active" forever once started even after `ufw disable`.
# The persisted truth is /etc/ufw/ufw.conf — `ufw enable/disable` mutates
# ENABLED=yes/no there, no sudo needed to read it.
#
# Active   → shield-check glyph + class "active"
# Inactive → shield-off-outline glyph (dimmed via CSS)

if grep -q '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then
  printf '{"text": "󰕥", "tooltip": "Firewall active", "class": "active"}\n'
else
  printf '{"text": "󰦞", "tooltip": "Firewall inactive"}\n'
fi
