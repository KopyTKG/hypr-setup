#!/bin/bash
# arch-webapp-migrate — move Omarchy-style web app launchers over to ours.
#
#   arch-webapp-migrate             migrate every launcher that still needs it
#   arch-webapp-migrate --dry-run   show what would change; touch nothing
#
# Rewrites, in ~/.local/share/applications/*.desktop,
#   Exec=omarchy-launch-webapp <url>
# into
#   Exec=arch-launch-webapp <class> <url>
# and adds StartupWMClass=<class> (as arch-webapp-install does). <class> is the
# launcher's Name as a slug ("Home Assistant" -> home-assistant), the same rule
# arch-webapp-install uses, made unique if two names collide.
#
# Why: omarchy-launch-webapp only resolved because ~/.local/share/omarchy/bin is
# still on PATH. arch-launch-webapp gives the window a stable class and focuses
# an already-open window instead of starting a second one.
#
# Safe to run twice: entries that no longer call omarchy-launch-webapp are left
# alone. The original is kept next to it as <file>.bak.<timestamp> (not a
# .desktop name, so launchers ignore it). Entries with extra arguments after the
# URL are reported and skipped. The URLs live only in your files, never here.
#
# APPLICATIONS_DIR overrides the folder (tests).

set -u
DIR=${APPLICATIONS_DIR:-$HOME/.local/share/applications}
TS=$(date +%s)
dry=0

case ${1:-} in
  -n|--dry-run) dry=1 ;;
  -h|--help)    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "")           ;;
  *)            echo "arch-webapp-migrate: unknown argument '$1' (see --help)" >&2; exit 2 ;;
esac

slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-\+//; s/-\+$//'; }

[[ -d $DIR ]] || { echo "no launcher folder at $DIR"; exit 0; }

# Classes already taken by launchers that are on arch-launch-webapp.
declare -A used=()
for f in "$DIR"/*.desktop; do
  [[ -f $f ]] || continue
  c=$(sed -n 's/^Exec=arch-launch-webapp[[:space:]]\+\([^[:space:]]\+\).*/\1/p' "$f" | head -1)
  [[ -n $c ]] && used[$c]=1
done

migrated=0 skipped=0
for f in "$DIR"/*.desktop; do
  [[ -f $f ]] || continue
  line=$(grep -m1 '^Exec=' "$f") || continue
  [[ $line == Exec=omarchy-launch-webapp* ]] || continue

  if [[ ! $line =~ ^Exec=omarchy-launch-webapp[[:space:]]+([^[:space:]]+)[[:space:]]*$ ]]; then
    echo "skip   $(basename "$f"): extra arguments after the URL — migrate by hand"
    skipped=$((skipped + 1)); continue
  fi
  url=${BASH_REMATCH[1]}

  name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
  class=$(slug "${name:-$(basename "$f" .desktop)}")
  [[ -n $class ]] || class="webapp-$TS"
  base=$class n=2
  while [[ -n ${used[$class]:-} ]]; do class="$base-$n"; n=$((n + 1)); done
  used[$class]=1

  printf '%s  %-24s class=%-22s %s\n' "$( ((dry)) && echo 'would ' || echo 'update')" "$(basename "$f")" "$class" "$url"
  (( dry )) && { migrated=$((migrated + 1)); continue; }

  cp -p -- "$f" "$f.bak.$TS" || { echo "  ! backup failed, left alone" >&2; continue; }
  tmp=$(mktemp "$DIR/.migrate.XXXXXX") || continue
  have=0; grep -q '^StartupWMClass=' "$f" && have=1
  # StartupWMClass goes right after Exec= (always in the main group, even when the
  # file has [Desktop Action ...] sections further down).
  NEW="Exec=arch-launch-webapp $class $url" CLASS=$class HAVE=$have awk '
    /^Exec=/ && !done { print ENVIRON["NEW"]; if (ENVIRON["HAVE"] == "0") print "StartupWMClass=" ENVIRON["CLASS"]; done = 1; next }
    { print }
  ' "$f" > "$tmp" && chmod --reference="$f" "$tmp" && mv -- "$tmp" "$f" || { rm -f "$tmp"; echo "  ! rewrite failed" >&2; continue; }
  migrated=$((migrated + 1))
done

if (( migrated == 0 && skipped == 0 )); then
  echo "nothing to migrate: no launcher uses omarchy-launch-webapp"
else
  verb=$( ((dry)) && echo 'would migrate' || echo 'migrated')
  echo; echo "$verb $migrated launcher(s)$( ((skipped)) && echo ", skipped $skipped")"
  (( dry )) || [[ $migrated -eq 0 ]] || echo "backups: $DIR/*.bak.$TS  (delete them once you are happy)"
fi
