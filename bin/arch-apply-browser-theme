#!/bin/bash
# Apply browser theme policy from repo to system policy dirs.
# The chromium/brave policy dirs on this system are world-writable, so no sudo.

set -e
SRC=$(dirname "$(readlink -f "$0")")/../chromium/policies/managed/color.json
[[ -f $SRC ]] || { echo "missing $SRC" >&2; exit 1; }

apply() {
  local dir=$1
  if [[ -d $dir && -w $dir ]]; then
    cp "$SRC" "$dir/color.json"
    echo "  → $dir/color.json"
  elif [[ -d $dir ]]; then
    sudo cp "$SRC" "$dir/color.json" && echo "  → $dir/color.json (via sudo)"
  fi
}

apply /etc/chromium/policies/managed
apply /etc/brave/policies/managed
apply /etc/opt/chrome/policies/managed
apply /etc/opt/edge/policies/managed

# Refresh policy in running browsers without a full restart
for cmd in chromium brave brave-browser google-chrome-stable; do
  if command -v $cmd >/dev/null && pgrep -x "$(basename "$cmd")" >/dev/null; then
    "$cmd" --refresh-platform-policy --no-startup-window &>/dev/null &
  fi
done
