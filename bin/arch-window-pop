#!/bin/bash
W=${1:-1300}; H=${2:-900}
active=$(hyprctl activewindow -j)
addr=$(jq -r '.address' <<<"$active")
pinned=$(jq -r '.pinned' <<<"$active")
[[ -z $addr || $addr == null ]] && exit 0
win="window = \"address:$addr\""
if [[ $pinned == "true" ]]; then
  hyprctl -q eval "hl.dispatch(hl.dsp.window.pin({ $win })); hl.dispatch(hl.dsp.window.float({ $win }))"
else
  hyprctl -q eval "hl.dispatch(hl.dsp.window.float({ $win }))
    hl.dispatch(hl.dsp.window.resize({ $win, x = $W, y = $H }))
    hl.dispatch(hl.dsp.window.center({ $win }))
    hl.dispatch(hl.dsp.window.pin({ $win }))
    hl.dispatch(hl.dsp.window.alter_zorder({ $win, mode = \"top\" }))"
fi
