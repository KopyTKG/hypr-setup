#!/bin/bash
# arch-protonge-remove — fzf-pick an installed GE-Proton release and rm -rf it.

set -e
TARGET_DIR="$HOME/.steam/root/compatibilitytools.d"

if [[ ! -d $TARGET_DIR ]]; then
  echo "$TARGET_DIR does not exist." >&2
  exit 1
fi

pick=$(find "$TARGET_DIR" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null \
  | sort \
  | fzf --multi \
        --prompt='ProtonGE remove> ' \
        --height=100% --reverse --border \
        --header='Tab to multi-select · Enter to delete · Esc to cancel')
[[ -z $pick ]] && { echo "Cancelled."; exit 0; }

echo
while IFS= read -r tag; do
  [[ -z $tag ]] && continue
  echo "→ rm -rf $TARGET_DIR/$tag"
  rm -rf "${TARGET_DIR:?}/$tag"
done <<< "$pick"

echo
echo "Done. Restart Steam to refresh its compatibility tool list."
read -r -p "[Enter to close]"
