#!/bin/bash
ON_TEMP=4000
OFF_TEMP=6000
if ! pgrep -x hyprsunset >/dev/null; then
  setsid uwsm-app -- hyprsunset >/dev/null 2>&1 & disown
  sleep 1
fi
current=$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+')
if [[ $current == $OFF_TEMP ]]; then
  hyprctl hyprsunset temperature $ON_TEMP
  notify-send -u low "Nightlight: on"
else
  hyprctl hyprsunset temperature $OFF_TEMP
  notify-send -u low "Nightlight: off"
fi
