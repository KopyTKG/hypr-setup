#!/bin/bash
# arch-keybinds — every keybind in one place: Hyprland, dialogs, shell, terminal,
# editor, waybar clicks, terminal UIs. Bound to SUPER+F1 and reachable from
# arch-menu → Keybinds.
#
#   arch-keybinds           spot dialog; type to filter ("fish", "yazi seek", "super 3")
#   arch-keybinds --md      the same data as Markdown (KEYBINDS.md is this output)
#   arch-keybinds --list    scope<TAB>keys<TAB>description, no colours (scripts, tests)
#   arch-keybinds --refresh rebuild the app caches (fish / kitty / yazi / mpv / nvim keys)
#   arch-keybinds header    the table's column header (also the label in spot-config/keybinds.toml)
#
# Sources:
#   - Hyprland binds        live from `hyprctl binds -j`, each put in a category
#   - Waybar clicks         generated from waybar/modules.jsonc (never goes stale)
#   - installed apps        read from the apps themselves: fish (`bind`), kitty (its default
#                           shortcuts), yazi (its compiled-in keymap + ~/.config/yazi/keymap.toml),
#                           mpv (input.conf), nvim (every mapping with a description). Cached in
#                           ~/.cache/arch-keybinds for 12 h or until the app's config changes.
#   - everything else       arch-menu/keybinds.conf  (Scope | Keys | Description), also the place
#                           for apps that cannot be read (btop, lazygit, zathura, ...)
#
# Where two Hyprland binds share a key combination both are listed and marked ⚠:
# both are registered, so expect one key press to be able to trigger both.
#
# Refresh the document:  arch-keybinds --md > ~/Projects/hypr-setup/KEYBINDS.md
#
# Test hooks: ARCH_KEYBINDS_HYPR_JSON (a file instead of hyprctl),
# ARCH_KEYBINDS_CONF, ARCH_KEYBINDS_WAYBAR, ARCH_KEYBINDS_NO_PROVIDERS=1 (skip the app
# sources), ARCH_KEYBINDS_REFRESH=1, ARCH_SPOT_DIR.

set -e

SW=28 KW=32                           # column widths of the table; the spot config's label must match
export SW KW
mode=view
case ${1:-} in
  "")       ;;
  header)   printf '%-*s %-*s %s\n' "$SW" SCOPE "$KW" KEYS "WHAT IT DOES"; exit 0 ;;
  --refresh) export ARCH_KEYBINDS_REFRESH=1; mode=none ;;
  --md)     mode=md ;;
  --list)   mode=list ;;
  --table)  mode=table ;;
  -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *)        echo "arch-keybinds: unknown argument '$1' (see --help)" >&2; exit 2 ;;
esac

if [[ -n ${ARCH_KEYBINDS_HYPR_JSON:-} ]]; then
  HYPR_JSON=$(cat "$ARCH_KEYBINDS_HYPR_JSON")
else
  HYPR_JSON=$(hyprctl binds -j 2>/dev/null) || { echo "arch-keybinds: hyprctl failed; Hyprland binds are missing" >&2; HYPR_JSON='[]'; }
fi
export HYPR_JSON
export CONF=${ARCH_KEYBINDS_CONF:-$HOME/.config/arch-menu/keybinds.conf}
export WAYBAR=${ARCH_KEYBINDS_WAYBAR:-$HOME/.config/waybar/modules.jsonc}

generate() {
python3 -I - "${1:-$mode}" << 'PY'
import json, os, re, sys

mode = sys.argv[1]

MOD_ORDER = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]
KEYCODE = {10: "1", 11: "2", 12: "3", 13: "4", 14: "5", 15: "6", 16: "7", 17: "8", 18: "9", 19: "0"}
KEYNAME = {"minus": "-", "equal": "=", "slash": "/", "COMMA": ",", "ESCAPE": "ESC", "Delete": "DELETE",
           "mouse_down": "SCROLL DOWN", "mouse_up": "SCROLL UP", "mouse:272": "LEFT DRAG", "mouse:273": "RIGHT DRAG"}

HYPR_CATEGORIES = [   # first match wins; (name, test on (key, description, mouse))
    ("Media & hardware", lambda k, d, m: k.startswith("XF86")),
    ("Mouse & scroll",   lambda k, d, m: m or k.startswith("mouse")),
    ("Workspaces",       lambda k, d, m: re.search(r"workspace|scratchpad", d, re.I)),
    ("Clipboard",        lambda k, d, m: re.search(r"\bcopy\b|\bpaste\b|\bcut\b|clipboard", d, re.I)),
    ("Notifications",    lambda k, d, m: re.search(r"notification", d, re.I)),
    ("Screenshots",      lambda k, d, m: re.search(r"screenshot|color picker", d, re.I)),
    ("Windows",          lambda k, d, m: re.search(r"window|focus|split|pseudo|full ?screen|group|scaling|"
                                                   r"expand|shrink|swap|close|monitor|full width", d, re.I)),
    ("Menus & system",   lambda k, d, m: re.search(r"menu|keybinds|lock|nightlight|idle|top bar|display|"
                                                   r"laptop|power|battery|bluetooth|wifi|activity|time|"
                                                   r"emoji|calculator|launch|settings|zoom", d, re.I)),
]
def hypr_category(key, desc, mouse):
    for name, test in HYPR_CATEGORIES:
        if test(key, desc, mouse):
            return name
    return "Apps"
# display order (classification above is first-match-wins; this is only how groups are listed)
HYPR_ORDER = ["Apps", "Menus & system", "Windows", "Workspaces", "Mouse & scroll",
              "Clipboard", "Screenshots", "Notifications", "Media & hardware"]
assert set(HYPR_ORDER) == {n for n, _ in HYPR_CATEGORIES} | {"Apps"}

rows = []                              # dicts: scope, group, plain, desc, sortkey
def add(scope, plain, desc, group=None, sortkey=None, extra=""):
    rows.append({"scope": scope, "group": group, "plain": plain, "desc": desc,
                 "sortkey": sortkey if sortkey is not None else len(rows), "extra": extra})

try:
    binds = json.loads(os.environ.get("HYPR_JSON") or "[]")
except json.JSONDecodeError:
    binds = []
seen = set()
for b in binds:
    desc = (b.get("description") or "").strip()
    if not desc:
        continue
    raw = b.get("key") or KEYCODE.get(b.get("keycode", 0), "code:" + str(b.get("keycode", 0)))
    mouse = bool(b.get("mouse"))
    mods = [name for bit, name in MOD_ORDER if b.get("modmask", 0) & bit]
    plain = " + ".join(mods + [KEYNAME.get(raw, raw)])
    if (plain, desc) in seen:
        continue
    seen.add((plain, desc))
    cat = hypr_category(raw, desc, mouse)
    add("Hyprland", plain, desc, group=cat, sortkey=(plain.count("+"), plain.lower()))

# ---------------------------------------------------------------- conflicts
by_combo = {}
for r in rows:
    if r["scope"] == "Hyprland" and "DRAG" not in r["plain"] and "SCROLL" not in r["plain"]:
        by_combo.setdefault(r["plain"], []).append(r)
conflicts = {k: v for k, v in by_combo.items() if len(v) > 1}
for combo, rs in conflicts.items():
    for r in rs:
        others = [o["desc"] for o in rs if o is not r]
        r["extra"] = "⚠ also: " + ", ".join(others)

# ---------------------------------------------------------------- waybar clicks
PRETTY = {"cpu": "CPU", "network": "Network", "bluetooth": "Bluetooth", "battery": "Battery",
          "pulseaudio": "Volume", "custom/launcher": "Logo", "custom/sockets": "Sockets",
          "custom/firewall": "Firewall", "custom/idle-indicator": "Idle lock",
          "custom/notification-silencing-indicator": "Notifications", "custom/updates": "Updates",
          "hyprland/language": "Keyboard layout"}
KNOWN = {"arch-power-menu": "Power menu", "arch-sockets": "Sockets table (every socket)",
         "arch-sockets --listening": "Sockets table (listening only)",
         "arch-firewall": "Firewall rules (add / delete / enable)",
         "arch-ufw": "Quick firewall toggle (enable / disable / reload)",
         "arch-toggle-idle": "Toggle locking on idle",
         "arch-toggle-notification-silencing": "Toggle silencing notifications",
         "arch-update-check": "Check for updates now", "arch-keyboard": "Pick the keyboard layout",
         "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle": "Mute / unmute"}
CLICKS = {"on-click": "CLICK", "on-click-right": "RIGHT CLICK", "on-click-middle": "MIDDLE CLICK",
          "on-scroll-up": "SCROLL UP", "on-scroll-down": "SCROLL DOWN"}

def describe(cmd):
    c = cmd.strip()
    if c in KNOWN:
        return KNOWN[c]
    m = re.match(r"arch-floatterm\s+\S+\s+(.*)$", c)
    if m:
        rest = m.group(1)
        e = re.search(r"exec\s+(\S+)", rest)
        prog = (e.group(1) if e else rest.split()[0]).strip("'\"")
        return f"Open {prog} in a floating terminal"
    if "xdg-terminal-exec" in c and "update" in c:
        return "Run the system update in a terminal"
    return c if len(c) <= 60 else c[:57] + "…"

try:
    text = re.sub(r"^\s*//.*$", "", open(os.environ["WAYBAR"]).read(), flags=re.M)
    modules = json.loads(text)
except (OSError, json.JSONDecodeError):
    modules = {}
for name, cfg in modules.items():
    if not isinstance(cfg, dict):
        continue
    pretty = PRETTY.get(name, name.split("/")[-1].replace("-", " ").title())
    for opt, label in CLICKS.items():
        if opt in cfg:
            add("Waybar", label, f"{pretty}: {describe(cfg[opt])}")

# ---------------------------------------------------------------- keybinds.conf
import shutil
NEEDS = {"lazygit": "lazygit", "lazydocker": "lazydocker", "btop": "btop", "zathura": "zathura", "gdu": "gdu",
         "Terminal (kitty)": "kitty"}
conf_scopes = []
try:
    for line in open(os.environ["CONF"]):
        line = line.rstrip("\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) != 3 or not all(parts):
            continue
        scope, keys, desc = parts
        need = NEEDS.get(scope)
        if need and shutil.which(need) is None:
            continue                       # that app is not installed: its keys do not belong here
        if scope not in conf_scopes:
            conf_scopes.append(scope)
        add(scope, keys, desc)
except OSError:
    print("arch-keybinds: no keybinds.conf; only Hyprland and waybar are listed", file=sys.stderr)

# ---------------------------------------------------------------- installed apps
# Read from the apps themselves where they expose their keys (never goes stale);
# anything curated lives in keybinds.conf. Slow sources are cached (providers.json).
import hashlib, shlex, shutil, subprocess, time

def norm(k): return re.sub(r"\s+", "", k).upper()
have_keys = {(r["scope"], norm(r["plain"])) for r in rows}
auto_scopes = []
def add_auto(scope, plain, desc):
    key = (scope, norm(plain))
    if not plain or key in have_keys:
        return
    have_keys.add(key)
    if scope not in auto_scopes and scope not in conf_scopes:
        auto_scopes.append(scope)
    add(scope, plain, desc)

def have(cmd): return shutil.which(cmd) is not None
def run(cmd, timeout=20):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env={**os.environ, "NO_COLOR": "1"}).stdout
    except (OSError, subprocess.SubprocessError):
        return ""

MODNAME = {"c": "CTRL", "ctrl": "CTRL", "control": "CTRL", "a": "ALT", "alt": "ALT", "m": "ALT", "meta": "ALT",
           "s": "SHIFT", "shift": "SHIFT", "d": "SUPER", "super": "SUPER", "cmd": "SUPER", "hyper": "SUPER"}
MODSORT = {"SUPER": 0, "CTRL": 1, "ALT": 2, "SHIFT": 3}
def join_key(mods, key):
    mods = sorted(set(mods), key=lambda m: MODSORT.get(m, 9))
    if mods and len(key) == 1 and key.isalpha():
        key = key.upper()                 # CTRL + U, not CTRL + u
    return " + ".join(mods + [key])
NAMED = {"esc": "ESC", "escape": "ESC", "enter": "ENTER", "return": "ENTER", "cr": "ENTER", "space": "SPACE", "tab": "TAB",
         "backspace": "BACKSPACE", "bs": "BACKSPACE", "delete": "DELETE", "del": "DELETE", "insert": "INSERT", "home": "HOME",
         "end": "END", "pageup": "PAGE UP", "pagedown": "PAGE DOWN", "up": "UP", "down": "DOWN", "left": "LEFT", "right": "RIGHT"}
def key_name(k):
    if k == " ": return "SPACE"
    k = k.strip()
    low = k.lower().replace("_", "").replace(" ", "")
    if low in NAMED: return NAMED[low]
    if re.fullmatch(r"f\d{1,2}", low): return low.upper()
    return k.upper().replace("_", " ") if len(k) > 1 else k

def pretty_angle(tok):                # <C-x> <A-Left> <Esc> <S-Enter> <C--> ...
    m = re.match(r"^<((?:[A-Za-z]+-)*)(.+)>$", tok)
    mods = [MODNAME.get(x.lower(), x.upper()) for x in m.group(1).split("-") if x] if m else []
    key = m.group(2) if m else tok.strip("<>")
    if len(key) == 1 and key.isupper(): mods.append("SHIFT")
    return join_key(mods, key_name(key.lower() if len(key) == 1 else key))

def pretty_seq(tokens, literal=False):  # yazi / nvim style: tokens are "g" "<C-x>" ...; literal: "K" stays K (vim)
    out = []
    for t in tokens:
        if t.startswith("<") and t.endswith(">") and len(t) > 2:
            out.append(pretty_angle(t))
        elif len(t) == 1 and t.isupper() and not literal:
            out.append(join_key(["SHIFT"], t))
        else:
            out.append(key_name(t) if t == " " else t)
    return "  then  ".join(out)

def humanize(cmd):
    c = cmd.strip().replace("_", " ")
    c = re.sub(r"^\s+|\s+$", "", c)
    return (c[:1].upper() + c[1:]) if c else c

def cached(name, make, sources):
    """JSON cache under ~/.cache/arch-keybinds: reused until older than 12 h or a source file changed."""
    d = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "arch-keybinds")
    path = os.path.join(d, name + ".json")
    newest = 0
    for src in sources:
        try:
            newest = max(newest, os.stat(src).st_mtime)
        except OSError:
            pass
    if os.environ.get("ARCH_KEYBINDS_REFRESH") != "1":
        try:
            if time.time() - os.stat(path).st_mtime < 12 * 3600 and os.stat(path).st_mtime >= newest:
                return json.load(open(path))
        except (OSError, json.JSONDecodeError):
            pass
    data = make()
    try:
        os.makedirs(d, exist_ok=True)
        json.dump(data, open(path, "w"))
    except OSError:
        pass
    return data

HOME = os.path.expanduser("~")

def fish_rows():
    out = []
    for line in run(["fish", "-c", "bind"]).splitlines():
        try: t = shlex.split(line)
        except ValueError: continue
        if not t or t[0] != "bind": continue
        i, mode = 1, "default"
        while i < len(t) and t[i].startswith("-"):
            if t[i] in ("-M", "-m", "--mode", "--sets-mode"): mode = t[i + 1]; i += 1
            i += 1
        if i >= len(t) or mode not in ("default", "insert"): continue
        key, cmd = t[i], " ".join(t[i + 1:])
        if not key or "\\" in key or "," in key or "[" in key or key.startswith("e") and not re.match(r"^(enter|end|escape)$", key) and len(key) > 1 and key[1] in "[O" or not cmd or cmd == "self-insert": continue
        parts = key.split("-")
        mods = [MODNAME.get(m.lower(), m.upper()) for m in parts[:-1]]
        out.append([join_key(mods, key_name(parts[-1])), humanize(cmd.replace("-", " "))])
    return out

def kitty_rows():
    # kitty +runpy exec()s this with separate globals/locals, so everything lives inside main()
    code = (
        "def main():\n"
        "    import json\n"
        "    from kitty.options.types import defaults\n"
        "    from kitty.key_encoding import functional_key_number_to_name_map as N\n"
        "    def name(k): return N.get(k) or chr(k)\n"
        "    def mods(m):\n"
        "        r=[]\n"
        "        if m & 256: r += ['CTRL','SHIFT']\n"
        "        if m & 8: r.append('SUPER')\n"
        "        if m & 4 and 'CTRL' not in r: r.append('CTRL')\n"
        "        if m & 2: r.append('ALT')\n"
        "        if m & 1 and 'SHIFT' not in r: r.append('SHIFT')\n"
        "        return r\n"
        "    out=[]\n"
        "    for kd in defaults.map:\n"
        "        ks=[kd.trigger]+list(kd.rest)\n"
        "        out.append([[mods(k.mods), str(name(k.key))] for k in ks]+[kd.definition])\n"
        "    print(json.dumps(out))\n"
        "main()\n")
    try:
        data = json.loads(run(["kitty", "+runpy", code]).strip().splitlines()[-1])
    except (json.JSONDecodeError, IndexError):
        return []
    rows_ = []
    for item in data:
        *ks, action = item
        keys = "  then  ".join(join_key(m, key_name(k)) for m, k in ks)
        rows_.append([keys, humanize(action)])
    return rows_

def yazi_rows():
    out = []
    km = os.path.join(HOME, ".config/yazi/keymap.toml")
    try:
        import tomllib
        for e in tomllib.load(open(km, "rb")).get("mgr", {}).get("prepend_keymap", []):
            on = e.get("on", []); on = [on] if isinstance(on, str) else on
            out.append([pretty_seq(on), e.get("desc") or e.get("run", "")])
    except Exception:
        pass
    # yazi's own default keymap is compiled into the binary; read it from there
    strings = run(["strings", "-n", "4", shutil.which("yazi") or "/usr/bin/yazi"], timeout=60).splitlines()
    start = next((i for i, l in enumerate(strings) if "schemas/keymap.json" in l), None)
    if start is not None:
        rx = re.compile(r'^\s*\{\s*on\s*=\s*(\[[^\]]*\]|"(?:[^"\\]|\\.)*")\s*,\s*run\s*=\s*(\[[^\]]*\]|"[^"]*"|\'[^\']*\')\s*(?:,\s*desc\s*=\s*"((?:[^"\\]|\\.)*)")?')
        for l in strings[start + 1:]:
            if re.match(r"^\[(tasks|spot|pick|input|confirm|cmp|help)\]", l):
                break
            m = rx.match(l)
            if m:
                on = re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))
                out.append([pretty_seq(on), m.group(3) or m.group(2).strip("\"'[] ")])
    return out

def mpv_rows():
    out, inside = [], False
    try:
        lines = open("/usr/share/doc/mpv/input.conf").read().splitlines()
    except OSError:
        return out
    for l in lines:
        if l.startswith("#default-bindings start"): inside = True; continue
        if l.startswith("#default-bindings end"): break
        if not inside or not re.match(r"^#[^ #]", l): continue
        m = re.match(r"^#(\S+)\s+(.+?)(?:\s+#\s*(.*))?$", l)
        if not m or m.group(2).startswith("{") or m.group(2).startswith("ignore"): continue
        key = m.group(1)
        km = re.match(r"^((?:\w+\+)*)(.+)$", key)             # "ctrl++" is ctrl and the plus key
        k, mods = km.group(2), [MODNAME.get(x.lower(), x.upper()) for x in km.group(1).split("+") if x]
        if len(k) == 1 and k.isupper(): mods.append("SHIFT"); k = k.lower()
        out.append([join_key(mods, k if len(k) == 1 else key_name(k)), m.group(3) or humanize(m.group(2))])
    return out

def nvim_rows():
    lua = ("local o={} for _,mode in ipairs({'n','v','x','i'}) do for _,m in ipairs(vim.api.nvim_get_keymap(mode)) do "
           "if m.desc and not m.lhs:find('<Plug>') and not m.lhs:find('<SNR>') then "
           "o[#o+1]={mode,m.lhs,m.desc} end end end io.stdout:write(vim.json.encode(o))")
    raw = run(["nvim", "--headless", "-i", "NONE", "-n", "+lua " + lua, "+qa!"], timeout=25)
    try:
        data = json.loads(raw[raw.index("["):])
    except (ValueError, json.JSONDecodeError):
        return []
    names = {"n": "", "v": "visual: ", "x": "visual: ", "i": "insert: "}
    out = []
    for mode, lhs, desc in data:
        toks = re.findall(r"<[^>]+>|.", lhs)
        out.append([pretty_seq(toks, literal=True).replace("  then  ", " "), names.get(mode, "") + desc])
    return out

PROVIDERS = [
    ("Shell (fish)",     "fish",   fish_rows,  [os.path.join(HOME, ".config/fish")]),
    ("Terminal (kitty)", "kitty",  kitty_rows, [os.path.join(HOME, ".config/kitty/kitty.conf")]),
    ("Yazi",             "yazi",   yazi_rows,  [os.path.join(HOME, ".config/yazi/keymap.toml")]),
    ("mpv",              "mpv",    mpv_rows,   ["/usr/share/doc/mpv/input.conf"]),
    ("Editor (nvim)",    "nvim",   nvim_rows,  [os.path.join(HOME, ".config/nvim")]),
]
if os.environ.get("ARCH_KEYBINDS_NO_PROVIDERS") != "1":
    for scope, binary, fn, srcs in PROVIDERS:
        if not have(binary):
            continue
        for keys, desc in cached(re.sub(r"\W+", "_", scope.lower()), fn, srcs):
            add_auto(scope, keys, desc)

# ---------------------------------------------------------------- order
scope_order = ["Hyprland"] + conf_scopes + auto_scopes
if "Waybar" not in scope_order:
    scope_order.append("Waybar")
def order(r):
    gi = HYPR_ORDER.index(r["group"]) if r["scope"] == "Hyprland" else 0
    return (scope_order.index(r["scope"]), gi, r["sortkey"] if isinstance(r["sortkey"], tuple) else (0, r["sortkey"]))
rows.sort(key=order)

def label(r):
    return f"Hyprland · {r['group']}" if r["scope"] == "Hyprland" else r["scope"]

# ---------------------------------------------------------------- output
if mode == "list":
    for r in rows:
        print(f"{label(r)}\t{r['plain']}\t{r['desc']}" + (f"  {r['extra']}" if r["extra"] else ""))

elif mode == "md":
    esc = lambda s: s.replace("|", "\\|")
    out = ["# Keybinds", "",
           "Every keybind in this setup, generated by `arch-keybinds --md` (the same data "
           "SUPER+F1 shows, where you can type to filter). Hyprland binds come from the live "
           "session, the waybar clicks from `waybar/modules.jsonc`, the keys of installed apps "
           "(fish, kitty, yazi, mpv, nvim) from the apps themselves, and the rest from "
           "[`arch-menu/keybinds.conf`](arch-menu/keybinds.conf) — edit that file for keys that "
           "cannot be read from an app, then regenerate:", "",
           "```sh", "arch-keybinds --md > ~/Projects/hypr-setup/KEYBINDS.md", "```", ""]
    if conflicts:
        out += ["> **⚠ Shared key combinations.** Two binds are registered for each of these, so one "
                "key press can trigger both: " + "; ".join(f"`{k}` ({' / '.join(r['desc'] for r in v)})" for k, v in conflicts.items()) + ".", ""]
    def table(rs):
        t = ["| Keys | What it does |", "|------|--------------|"]
        for r in rs:
            d = esc(r["desc"]) + (f" **{esc(r['extra'])}**" if r["extra"] else "")
            t.append(f"| `{esc(r['plain'])}` | {d} |")
        return t + [""]
    for scope in scope_order:
        srows = [r for r in rows if r["scope"] == scope]
        if not srows:
            continue
        out += [f"## {scope}", ""]
        if scope == "Hyprland":
            for cat in HYPR_ORDER:
                crs = [r for r in srows if r["group"] == cat]
                if crs:
                    out += [f"### {cat}", ""] + table(crs)
        else:
            out += table(srows)
    print("\n".join(out).rstrip() + "\n")

else:  # table: aligned plain rows for the spot dialog (widths shared with `header`)
    SW, KW = int(os.environ["SW"]), int(os.environ["KW"])
    cut = lambda t, w: t if len(t) <= w else t[:w - 1] + "~"
    for r in rows:
        desc = r["desc"] + (f"  {r['extra']}" if r["extra"] else "")
        print(f"{cut(label(r), SW):<{SW}} {cut(r['plain'], KW):<{KW}} {desc}")
PY
}

case $mode in
  view)
    if ! command -v spot >/dev/null 2>&1; then
      echo "arch-keybinds: spot is not installed; printing the table instead" >&2
      generate table; exit 0
    fi
    table=$(generate table)
    printf '%s\n' "$table" | SPOT_TITLE="Keybinds · $(grep -c . <<<"$table") of them" spot "${ARCH_SPOT_DIR:-$HOME/.config/spot}/keybinds.toml" >/dev/null || true ;;
  none)  generate list >/dev/null; echo "keybind caches refreshed" ;;
  table) generate table ;;
  *)     generate ;;
esac
