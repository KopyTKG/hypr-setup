#!/bin/bash
# arch-passwords [passwords|otp] — the Chromium extension popups as their own floating
# window, for use over the webapps. Webapp windows are `chromium --app` windows: they
# have no toolbar, so the extension buttons cannot be clicked there. An extension's
# popup is just a page, so it opens fine as a window of its own (the same window the
# extension makes for its login). Press the key again to close it.
#
#   arch-passwords            Passwords for Nextcloud   (SUPER+ALT+P)
#   arch-passwords otp        Nextcloud OTP Manager     (SUPER+ALT+O)
#
# Search an entry in the window, copy the password / code with its button, paste it
# into the webapp (the extensions have clipboard access). The extension ids are the
# Chrome Web Store ones; Chromium names the window after the page, so the window
# rule in hypr/windows.lua matches these classes.

case ${1:-passwords} in
  passwords) id=mhajlicjhgoofheldnmollgbgjheenbi; page=html/popup.html; class="chrome-${id}__html_popup.html-Default" ;;
  otp)       id=ljbdflkioncfbcncbnijleofalpakhlf; page=popup.html;      class="chrome-${id}__popup.html-Default" ;;
  *) echo "usage: arch-passwords [passwords|otp]" >&2; exit 2 ;;
esac

if hyprctl clients -j | grep -q "\"class\": \"$class\""; then
  hyprctl dispatch "hl.dsp.focus({ window = \"class:^$class\$\" })" >/dev/null
  exec hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
fi
exec uwsm-app -- chromium --app="chrome-extension://$id/$page"
