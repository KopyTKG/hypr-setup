    *Disk*)         arch-floatterm arch-installer arch-disk ;;
    *Back*)         show_main ;;
  esac
}


# ---------- Remote ----------
# Builds the host list from ~/.ssh/config and every file it Includes (relative
# paths resolve against ~/.ssh, globs and ~ work, nesting is followed).
# A host's group is the nearest "# group: NAME" marker above it in its file;
# without one, the folder the file lives in (~/.ssh/infra/config -> "infra"),
# or "Ungrouped" for ~/.ssh/config itself. Wildcard hosts and git forges
# (github.com & co: nothing to log in to) are left out.
_ssh_config_files() {
  local f=$1 depth=${2:-0} kw rest p g
  [[ -f $f && $depth -lt 8 ]] || return 0
  echo "$f"
  while read -r kw rest; do
    [[ ${kw,,} == include ]] || continue
    for p in $rest; do
      p=${p/#\~/$HOME}
      [[ $p == /* ]] || p="$HOME/.ssh/$p"
      for g in $p; do _ssh_config_files "$g" $((depth + 1)); done
    done
  done < "$f"
}

_ssh_grouped() {
  local files=()
  mapfile -t files < <(_ssh_config_files "$HOME/.ssh/config")
  [[ ${#files[@]} -gt 0 ]] || return 0
  awk -v root="$HOME/.ssh/" '
    FNR == 1 {
      rel = FILENAME
      if (index(rel, root) == 1) rel = substr(rel, length(root) + 1)
      group = (rel ~ /\//) ? substr(rel, 1, index(rel, "/") - 1) : "Ungrouped"
    }
    /^[[:space:]]*#[[:space:]]*[Gg]roup[[:space:]]*:/ {
      sub(/^[[:space:]]*#[[:space:]]*[Gg]roup[[:space:]]*:[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      group = $0
      next
    }
    tolower($1) == "host" {
      for (i = 2; i <= NF; i++)
        if ($i !~ /[*?!]/ && $i !~ /^(github\.com|gitlab\.com|bitbucket\.org|aur\.archlinux\.org)$/)
          printf "%s\t%s\n", group, $i
    }
  ' "${files[@]}" 2>/dev/null
}

show_remote() {
  local items=() pick group seen
  seen=$(mktemp); trap 'rm -f "$seen"' RETURN
  while IFS= read -r group; do
    [[ -z $group ]] && continue
    grep -qxF "$group" "$seen" && continue
    echo "$group" >> "$seen"
    items+=("  $group")
  done < <(_ssh_grouped | cut -f1)
  items+=("  Custom...")

  pick=$(menu "Remote" "${items[@]}")
  case "$pick" in
    *Back*)   show_main ;;
    *Custom*) arch-floatterm arch-installer arch-remote-custom ;;
    "")       : ;;
    *)        group="${pick#*  }"; show_remote_group "$group" ;;
  esac
}

show_remote_group() {
  local group=$1 items=() pick host
  while IFS= read -r host; do
    [[ -z $host ]] && continue
    items+=("  $host")
  done < <(_ssh_grouped | awk -F'\t' -v g="$group" '$1==g {print $2}' | sort -u)

  pick=$(menu "$group" "${items[@]}")
  case "$pick" in
    *Back*)  show_remote ;;
    "")      : ;;
    *)       host="${pick##* }"
             [[ -n $host ]] && setsid -f arch-floatterm ssh-session ssh "$host" >/dev/null 2>&1 & disown ;;
  esac
}



# ---------- Bookmarks ----------
# Reads ~/.config/arch-menu/bookmarks.conf (one "Label | URL" per line).
# Lines starting with # are comments; blank lines ignored.
show_bookmarks() {
  local conf="$HOME/.config/arch-menu/bookmarks.conf" items=() pick label url
  if [[ ! -f $conf ]]; then
    menu "Bookmarks" "  (no bookmarks.conf yet)" >/dev/null
    show_main
    return
  fi
  while IFS= read -r line; do
    [[ -z $line || $line =~ ^[[:space:]]*# ]] && continue
    label="${line%%|*}"
    label="${label#"${label%%[![:space:]]*}"}"
    label="${label%"${label##*[![:space:]]}"}"
    [[ -z $label ]] && continue
    items+=("  $label")
  done < "$conf"

  pick=$(menu "Bookmarks" "${items[@]}")
  case "$pick" in
    *Back*) show_main ;;
    "")     : ;;
    *)      label="${pick#*  }"
            url=$(awk -F'|' -v L="$label" '
              !/^[[:space:]]*#/ && NF==2 {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                if ($1 == L) { print $2; exit }
              }' "$conf")
            [[ -n $url ]] && open_url "$url" ;;
  esac
}



# ---------- Remove ----------
# Helper: install a removal task into a floating alacritty (mirrors term_install).
term_remove() {
  uwsm-app -- xdg-terminal-exec bash -c "sudo pacman -Rns $*; echo; read -p 'Press Enter to close.'"
}

show_remove() {
  case $(menu "Remove" \
    "  Pacman" \
    "  AUR" \
    "  Webapp" \
    "  Development" \
    "  Gaming" \
    "  Terminal" \
    "  Font" \
    "  ProtonGE" \
    "  Cache") in
    *Pacman*)      arch-floatterm arch-installer arch-pacman-remove ;;
    *AUR*)         arch-floatterm arch-installer arch-aur-remove ;;
    *Webapp*)      arch-floatterm arch-installer arch-webapp-remove ;;
    *Development*) arch-floatterm arch-installer arch-mise-remove ;;
    *Gaming*)      show_remove_gaming ;;
    *Terminal*)    show_remove_terminal ;;
    *Font*)        show_remove_font ;;
    *ProtonGE*)    arch-floatterm arch-installer arch-protonge-remove ;;
    *Cache*)       arch-floatterm arch-installer arch-cache-clean ;;
    *Back*)        show_main ;;
  esac
}

