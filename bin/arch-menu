# ---------- System ----------
show_system() {
  case $(menu "System" \
    "  Lock" \
    "  Battery" \
    "  Time" \
    "  Power menu" \
    "  Info" \
    "  Files" \
    "  Back") in
    *Lock*)         hyprlock ;;
    *Battery*)      notify-send -u low "$(arch-battery-status)" ;;
    *Time*)         notify-send -u low "$(date +"%A %H:%M  ·  %d %B %Y  ·  Week %V")" ;;
    *"Power menu"*) arch-power-menu ;;
    *Info*)         uwsm-app -- xdg-terminal-exec bash -c "fastfetch; read -p 'Press Enter to close.'" ;;
    *Files*)        arch-floatterm yazi yazi ;;
    *Back*)         show_main ;;
  esac
}


# ---------- Remote ----------
# Parses ~/.ssh/config for "# group: NAME" markers and groups Host entries
# under whatever marker preceded them. Wildcard hosts are filtered out.
_ssh_grouped() {
  awk '
    BEGIN { group = "Ungrouped" }
    /^[[:space:]]*#[[:space:]]*[Gg]roup[[:space:]]*:/ {
      sub(/^[[:space:]]*#[[:space:]]*[Gg]roup[[:space:]]*:[[:space:]]*/, "")
      sub(/[[:space:]]+$/, "")
      group = $0
      next
    }
    tolower($1) == "host" {
      for (i = 2; i <= NF; i++)
        if ($i !~ /[*?!]/)
          printf "%s\t%s\n", group, $i
    }
  ' "$HOME/.ssh/config" 2>/dev/null
}

show_remote() {
  local items=() pick group seen
  seen=$(mktemp); trap 'rm -f "$seen"' RETURN
  while IFS= read -r group; do
    [[ -z $group ]] && continue
    grep -qxF "$group" "$seen" && continue
    echo "$group" >> "$seen"
    items+=("  $group")
  done < <(_ssh_grouped | cut -f1)
  items+=("  Custom...")
  items+=("  Back")

  pick=$(menu "Remote" "${items[@]}")
  case "$pick" in
    *Back*)   show_main ;;
    *Custom*) arch-floatterm arch-installer arch-remote-custom ;;
    "")       : ;;
    *)        group="${pick#*  }"; show_remote_group "$group" ;;
  esac
}

show_remote_group() {
  local group=$1 items=() pick host
  while IFS= read -r host; do
    [[ -z $host ]] && continue
    items+=("  $host")
  done < <(_ssh_grouped | awk -F'\t' -v g="$group" '$1==g {print $2}' | sort -u)
  items+=("  Back")

  pick=$(menu "$group" "${items[@]}")
  case "$pick" in
    *Back*)  show_remote ;;
    "")      : ;;
    *)       host="${pick##* }"
             [[ -n $host ]] && setsid -f arch-floatterm ssh-session ssh "$host" >/dev/null 2>&1 & disown ;;
  esac
}



# ---------- Bookmarks ----------
# Reads ~/.config/arch-menu/bookmarks.conf (one "Label | URL" per line).
# Lines starting with # are comments; blank lines ignored.
show_bookmarks() {
  local conf="$HOME/.config/arch-menu/bookmarks.conf" items=() pick label url
  if [[ ! -f $conf ]]; then
    menu "Bookmarks" "  (no bookmarks.conf yet)" "  Back" >/dev/null
    show_main
    return
  fi
  while IFS= read -r line; do
    [[ -z $line || $line =~ ^[[:space:]]*# ]] && continue
    label="${line%%|*}"
    label="${label#"${label%%[![:space:]]*}"}"
    label="${label%"${label##*[![:space:]]}"}"
    [[ -z $label ]] && continue
    items+=("  $label")
  done < "$conf"
  items+=("  Back")

  pick=$(menu "Bookmarks" "${items[@]}")
  case "$pick" in
    *Back*) show_main ;;
    "")     : ;;
    *)      label="${pick#*  }"
            url=$(awk -F'|' -v L="$label" '
              !/^[[:space:]]*#/ && NF==2 {
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                if ($1 == L) { print $2; exit }
              }' "$conf")
            [[ -n $url ]] && open_url "$url" ;;
  esac
}



# ---------- Remove ----------
# Helper: install a removal task into a floating alacritty (mirrors term_install).
term_remove() {
  uwsm-app -- xdg-terminal-exec bash -c "sudo pacman -Rns $*; echo; read -p 'Press Enter to close.'"
}

show_remove() {
  case $(menu "Remove" \
    "  Pacman" \
    "  AUR" \
    "  Webapp" \
    "  Development" \
    "  Gaming" \
    "  Terminal" \
    "  Font" \
    "  ProtonGE" \
    "  Back") in
    *Pacman*)      arch-floatterm arch-installer arch-pacman-remove ;;
    *AUR*)         arch-floatterm arch-installer arch-aur-remove ;;
    *Webapp*)      arch-floatterm arch-installer arch-webapp-remove ;;
    *Development*) arch-floatterm arch-installer arch-mise-remove ;;
    *Gaming*)      show_remove_gaming ;;
    *Terminal*)    show_remove_terminal ;;
    *Font*)        show_remove_font ;;
    *ProtonGE*)    arch-floatterm arch-installer arch-protonge-remove ;;
    *Back*)        show_main ;;
  esac
}

show_remove_gaming() {
  case $(menu "Gaming" \
    "  Steam" \
    "  RetroArch" \
    "  Minecraft" \
    "  Moonlight" \
    "  Lutris" \
    "  Heroic" \
    "  Back") in
