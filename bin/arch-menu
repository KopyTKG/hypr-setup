# ---------- Work ----------
WORK_DIR="$HOME/Projects/hypr-setup/work-scripts"
show_work() {
  case $(menu "Work" \
    "  API gen") in
    *"API gen"*) arch-floatterm arch-installer "$WORK_DIR/work-apigen" ;;
    *Back*)      show_main ;;
  esac
}

# `arch-menu [name]` opens that menu (what Back from a child script runs).
if declare -F "show_${1:-main}" >/dev/null; then "show_${1:-main}"; else show_main; fi
