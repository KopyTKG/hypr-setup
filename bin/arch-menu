    *RetroArch*) term_remove retroarch ;;
    *Minecraft*) term_remove minecraft-launcher ;;
    *Moonlight*) term_remove moonlight-qt ;;
    *Lutris*) term_remove lutris ;;
    *Heroic*) term_remove heroic-games-launcher-bin ;;
    *Back*)      show_remove ;;
  esac
}

