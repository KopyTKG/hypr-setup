#!/bin/bash
# arch-menu — hierarchical spot-based launcher (vanilla, post-omarchy)

# Daemon-era spot understands --chain/--back/--dismiss; older builds reject
# them, so only use them when present.
SPOT_FLAGS_CHAIN=
SPOT_HAS_BACK=
_help=$(spot --help 2>&1)
[[ $_help == *--chain* ]] && SPOT_FLAGS_CHAIN=--chain
[[ $_help == *--back* ]] && SPOT_HAS_BACK=1
unset _help
# arch-menu is the root of the navigation: never inherit someone else's Back.
unset SPOT_BACK

BACK_ROW="  Back"

# `menu` takes a title then any number of items. Each item is one menu line.
#   MENU_CHAIN=1  most choices here lead to another menu, so keep the window up
#                 for it instead of letting it close and reopen.
#   MENU_ROOT=1   top-level menu: nothing to go back to.
# Every other menu gets Back: spot's header button / Backspace / Alt+Left (exit
# status 4), reported to the caller as the "Back" line the case statements below
# match with *Back*. An older spot gets a Back list row instead.
menu() {
  local title="$1"; shift
  local flags= out rc
  [[ -n ${MENU_CHAIN:-} ]] && flags=$SPOT_FLAGS_CHAIN
  if [[ -z ${MENU_ROOT:-} ]]; then
    if [[ -n $SPOT_HAS_BACK ]]; then flags+=" --back"; else set -- "$@" "$BACK_ROW"; fi
  fi
  out=$(printf '%s\n' "$@" | SPOT_TITLE="$title" spot $flags ~/.config/spot/menu.toml)
  rc=$?
  if (( rc == 4 )); then printf '%s\n' "$BACK_ROW"; return 0; fi
  printf '%s\n' "$out"
  return $rc
}

# After a choice that does NOT lead to another spot dialog: let go of a window
# held open for a chain, so it does not linger over whatever opens next.
release() { spot --dismiss 2>/dev/null || true; }

term_install() {
  uwsm-app -- xdg-terminal-exec bash -c "yay -S $*; echo; read -p 'Press Enter to close.'"
}

editor()   { uwsm-app -- xdg-terminal-exec nvim "$1"; }
open_url() { uwsm-app -- chromium "$1"; }


# ---------- Top level ----------
show_main() {
  case $(MENU_ROOT=1 MENU_CHAIN=1 menu "Menu" \
    "  Apps" \
    "  Install" \
    "  Update" \
    "  Remove" \
    "  Capture" \
    "  Toggle" \
    "  Setup" \
    "  Bookmarks" \
    "  System" \
    "  Remote" \
    "  Work" \
    "  Keybinds" \
    "  Learn" \
    "  Power") in
    *Apps*)    release; walker ;;
    *Learn*)   show_learn ;;
    *Capture*) show_capture ;;
    *Toggle*)  show_toggle ;;
    *Setup*)   show_setup ;;
    *Install*) show_install ;;
    *Update*)  release; uwsm-app -- xdg-terminal-exec bash -c "fish -c update; read -p 'Press Enter to close.'" ;;
    *Remove*)  show_remove ;;
    *System*)  show_system ;;
    *Remote*)  show_remote ;;
    *Work*)    show_work ;;
    *Keybinds*) release; arch-floatterm arch-installer arch-keybinds ;;
    *Bookmarks*) show_bookmarks ;;
    *Power*)   SPOT_BACK="arch-menu main" arch-power-menu ;;
  esac
}


# ---------- Learn ----------
show_learn() {
  case $(menu "Learn" \
    "  Arch Wiki" \
    "  Hyprland Wiki" \
    "  Waybar Wiki" \
    "  Walker" \
    "  Elephant" \
    "  Spot" \
    "  Bash cheatsheet") in
    *"Arch Wiki"*) open_url "https://wiki.archlinux.org/title/Main_page" ;;
    *Hyprland*)    open_url "https://wiki.hypr.land/" ;;
    *Waybar*)      open_url "https://github.com/Alexays/Waybar/wiki" ;;
    *Walker*)      open_url "https://github.com/abenz1267/walker" ;;
    *Elephant*)    open_url "https://github.com/abenz1267/elephant" ;;
    *Spot*)        open_url "https://github.com/KopyTKG/spot/tree/main/docs" ;;   # TOML + CSS reference
    *Bash*)        open_url "https://devhints.io/bash" ;;
    *Back*)        show_main ;;
  esac
}


