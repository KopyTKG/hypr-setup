#!/bin/bash
# Power menu (Power + Battery sections): spot tile picker, dispatches to systemctl/hyprlock/uwsm/waybar.

# Battery section opens on the active power profile and badges it as active
# (needs spot >= 0.3; older spot ignores the variables and uses the config's default).
current=$(powerprofilesctl get 2>/dev/null || echo balanced)

out=$(SPOT_DEFAULT_BATTERY="$current" SPOT_CURRENT_BATTERY="$current" spot ~/.config/spot/power.toml) || exit 0
section=$(jq -r '._active' <<<"$out")
action=$(jq -r '.action' <<<"$out")
battery=$(jq -r '.battery' <<<"$out")

if [[ $section == battery ]]; then
  powerprofilesctl set "$battery"
  exit 0
fi

case "$action" in
  lock)      hyprlock ;;
  suspend)   systemctl suspend ;;
  hibernate) systemctl hibernate ;;
  logout)    nohup bash -c "sleep 1 && uwsm stop" >/dev/null 2>&1 & ;;
  restart)   nohup bash -c "sleep 1 && systemctl reboot --no-wall" >/dev/null 2>&1 & ;;
  shutdown)  nohup bash -c "sleep 1 && systemctl poweroff --no-wall" >/dev/null 2>&1 & ;;
esac
