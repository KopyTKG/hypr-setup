#!/bin/bash
# arch-reload TARGET — reload/restart one piece of the desktop.
#   hyprland | waybar | mako | hypridle | walker | wallpaper | all
# Mirrors what hypr/defaults/autostart.lua starts at login.

restart() {  # restart PROC CMD...  (kill, then relaunch under uwsm like autostart does)
  local proc=$1; shift
  pkill -x "$proc" 2>/dev/null
  while pgrep -x "$proc" >/dev/null; do sleep 0.1; done
  setsid -f uwsm-app -- "$@" >/dev/null 2>&1
}

do_one() {
  case "$1" in
    hyprland)  hyprctl reload >/dev/null ;;
    waybar)    restart waybar waybar ;;
    mako)      makoctl reload ;;
    hypridle)  restart hypridle hypridle ;;
    walker)    systemctl --user restart elephant.service ;;
    wallpaper) restart swaybg swaybg -i ~/.config/hypr/theme/background.jpg -m fill ;;
    *) notify-send -u critical "Reload" "unknown target: $1"; return 1 ;;
  esac
}

target=${1:?usage: arch-reload hyprland|waybar|mako|hypridle|walker|wallpaper|all}
if [[ $target == all ]]; then
  for t in hyprland waybar mako hypridle walker wallpaper; do do_one "$t"; done
else
  do_one "$target" || exit 1
fi
notify-send -u low "Reload" "$target"
