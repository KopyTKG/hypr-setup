<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"></requires>
  <object class="GtkWindow" id="Window">
    <style>
      <class name="window"></class>
    </style>
    <property name="resizable">false</property>
    <property name="title">arch-askpass</property>
    <child>
      <object class="GtkBox" id="BoxWrapper">
        <style>
          <class name="box-wrapper"></class>
        </style>
        <property name="orientation">vertical</property>
        <property name="halign">fill</property>
        <property name="valign">center</property>
        <property name="hexpand">true</property>
        <property name="spacing">0</property>

        <!-- Title + input + footer wrapped in one chrome pill -->
        <child>
          <object class="GtkBox" id="ContentPill">
            <style>
              <class name="content-pill"></class>
            </style>
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>

            <child>
              <object class="GtkLabel" id="AskpassTitle">
                <style>
                  <class name="askpass-title"></class>
                </style>
                <property name="label">Unlock SSH key</property>
                <property name="halign">center</property>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="SearchContainer">
                <style>
                  <class name="search-container"></class>
                </style>
                <property name="orientation">horizontal</property>
                <property name="halign">fill</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkEntry" id="Input">
                    <style>
                      <class name="input"></class>
                    </style>
                    <property name="halign">fill</property>
                    <property name="hexpand">true</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="AskpassFooter">
                <style>
                  <class name="askpass-footer"></class>
                </style>
                <property name="label">[esc] cancel    [enter] unlock</property>
                <property name="halign">center</property>
              </object>
            </child>

          </object>
        </child>

        <!-- Walker requires Box + result widgets to exist; keep but hidden -->
        <child>
          <object class="GtkBox" id="Box">
            <property name="visible">false</property>
            <child>
              <object class="GtkBox" id="ContentContainer">
                <child>
                  <object class="GtkLabel" id="ElephantHint"></object>
                </child>
                <child>
                  <object class="GtkLabel" id="Placeholder"></object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="Scroll">
                    <child>
                      <object class="GtkGridView" id="List"></object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="Preview"></object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="Keybinds">
                <child>
                  <object class="GtkBox" id="GlobalKeybinds"></object>
                </child>
                <child>
                  <object class="GtkBox" id="ItemKeybinds"></object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="Error"></object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>
